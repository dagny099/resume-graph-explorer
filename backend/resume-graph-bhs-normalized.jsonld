    "http://schema.org/description": [
      {
        "@value": "Designed a Python / scikit-learn classification model to automate medical bill categorization with performance comparable to human coders. Led a digital transformation effort improving adjudication & analytics workflows, achieving ~30% faster processing time, meaningful cost saving. Co-led Lean Six Sigma workshops to identify process inefficiencies and operational improvements, reducing error rates by ~25%. Delivered in an Agile environment (Jira), presenting analysis and recommendations to executive stakeholders"
      }
    ],
